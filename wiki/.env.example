# Copy with `make init`; never commit the generated .env.
WIKI_PUBLIC_URL=http://localhost:18088
WIKI_HOST=localhost:18088
WIKI_CADDY_ADDRESS=:80
WIKI_BIND_IP=127.0.0.1
WIKI_HTTP_PORT=18088
WIKI_HTTPS_PORT=18443
WIKI_SITE_NAME="封神榜 Wiki"
WIKI_DB_NAME=fengshenbang
WIKI_DB_USER=wiki
WIKI_DB_PASSWORD=replace-with-a-random-secret
MARIADB_ROOT_PASSWORD=replace-with-a-different-random-secret
MW_SECRET_KEY=replace-with-at-least-64-random-hex-characters
WIKI_ADMIN_USER=WikiSysop
WIKI_ADMIN_PASSWORD=replace-with-a-strong-random-password

# Public launch gates. Keep email confirmation off only for local staging.
WIKI_REQUIRE_EMAIL_CONFIRMATION=false
WIKI_REQUIRE_2FA=false
WIKI_ENABLE_APPROVED_REVS=true
WIKI_CAPTCHA_QUESTION="请输入本站中文名（四个汉字）"
WIKI_CAPTCHA_ANSWER="封神榜维基"

# Configure before opening registration on the internet.
WIKI_SMTP_HOST=
WIKI_SMTP_PORT=587
WIKI_SMTP_USER=
WIKI_SMTP_PASSWORD=
WIKI_SMTP_ENCRYPTION=tls
WIKI_NOTIFICATION_EMAIL=
